---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const ownerUrl = "https://viruchith.com";
const contactEmail = "hello@explodenot.com";

const socialLinks = {
  github: "https://github.com/explodenot",
  linkedin: "https://www.linkedin.com/company/explodenot/",
  x: "https://x.com/explodenot"
};
---

<Layout>
  <!-- Subtle architectural background rivets grid -->
  <div class="fixed inset-0 pointer-events-none avionics-rivets opacity-35 z-0" aria-hidden="true"></div>

  <!-- Main Container -->
  <div class="relative z-10 max-w-4xl mx-auto w-full px-4 sm:px-8 py-10 sm:py-20 flex-1 flex flex-col justify-between">
    
    <!-- Top System Header / Enterprise Loading State -->
    <header class="border-b border-[#1f2c37] pb-5 mb-10 sm:mb-16 flex flex-wrap items-center justify-between gap-4 text-xs font-mono tracking-wider text-[#8899a6]">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 text-[#e2e8f0] hover:text-[#ff5722] transition-colors focus:outline-none focus:ring-2 focus:ring-[#ff5722] rounded py-0.5">
          <img src="/logo.png" alt="Explodenot Logo" width="28" height="28" class="rounded object-contain" />
          <span class="font-bold tracking-widest uppercase">EXPLODENOT</span>
        </a>
      </div>

      <div class="flex items-center gap-4">
        <span>PHASE: <strong class="text-[#ff5722]">FORMATION & INITIALIZATION</strong></span>
        <span class="hidden sm:inline-block text-[#364958]" aria-hidden="true">|</span>
        <span class="hidden sm:inline-block text-[#8899a6]">SECURE CORE</span>
      </div>
    </header>

    <!-- Main Content Body -->
    <main class="my-auto flex flex-col gap-10">
      
      <!-- Stamped Classification Pill -->
      <div class="inline-flex items-center self-start border border-[#ff5722]/40 bg-[#ff5722]/5 px-4 py-2 rounded text-xs font-mono text-[#ff5722] tracking-wider uppercase font-semibold">
        <svg class="w-4 h-4 mr-2.5 text-[#ff5722] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>ENTERPRISE SOFTWARE DEVELOPMENT // PRE-LAUNCH INITIALIZATION</span>
      </div>

      <!-- Hero Heading & Value Proposition -->
      <div class="space-y-6">
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-[#f1f5f9] leading-[1.08] max-w-3xl text-balance">
          Software that doesn’t go boom.
        </h1>
        <p class="text-xl sm:text-2xl text-[#94a3b8] font-normal leading-relaxed max-w-2xl text-pretty">
          Resilient, scalable, and secure enterprise software development. <span class="text-[#e2e8f0] font-medium">Fewer fireworks, more sleep.</span>
        </p>
      </div>

      <!-- Enterprise Loading Manifest Section (Flat hierarchy, zero fake metrics) -->
      <div class="border border-[#1f2c37] bg-[#131a20]/90 rounded-lg p-6 sm:p-8 relative overflow-hidden backdrop-blur-sm shadow-xl shadow-black/40">
        <div class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-[#ff5722] via-[#00e676] to-[#1f2c37]" aria-hidden="true"></div>
        
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-6 border-b border-[#1f2c37]">
          <div class="max-w-[65ch]">
            <h2 class="text-base sm:text-lg font-bold text-[#f8fafc] flex items-center gap-2">
              <span class="text-[#ff5722]" aria-hidden="true">▶</span>
              Company Status: Loading Core Operations
            </h2>
            <p class="text-sm text-[#8899a6] mt-1.5 leading-relaxed max-w-[60ch]">
              Explodenot is an upcoming enterprise software development firm engineered from day one for extreme fault tolerance, unshakeable scalability, and deep architectural security. Pre-launch initialization is currently underway.
            </p>
          </div>
          <div class="shrink-0">
            <span class="font-mono text-xs bg-[#0b0f12] text-[#00e676] border border-[#00e676]/40 px-3.5 py-2 rounded inline-block font-semibold tracking-wider">
              LOADING // STANDBY
            </span>
          </div>
        </div>

        <!-- Architectural Pillars: Flattened cleanly with dividers, no nested cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 font-mono text-xs divide-y sm:divide-y-0 sm:divide-x divide-[#1f2c37]">
          <div class="pt-4 sm:pt-0 sm:pr-4">
            <div class="text-[#ff5722] text-xs uppercase tracking-wider mb-2 font-semibold">01 // Resilience</div>
            <p class="text-[#8899a6] text-xs font-sans leading-relaxed max-w-[32ch]">
              Zero single-point-of-failure architectures and graceful degradation under catastrophic conditions.
            </p>
          </div>
          <div class="pt-4 sm:pt-0 sm:px-4">
            <div class="text-[#ff5722] text-xs uppercase tracking-wider mb-2 font-semibold">02 // Scalability</div>
            <p class="text-[#8899a6] text-xs font-sans leading-relaxed max-w-[32ch]">
              Distributed systems designed to absorb high throughput without latency spikes or thermal degradation.
            </p>
          </div>
          <div class="pt-4 sm:pt-0 sm:pl-4">
            <div class="text-[#ff5722] text-xs uppercase tracking-wider mb-2 font-semibold">03 // Security</div>
            <p class="text-[#8899a6] text-xs font-sans leading-relaxed max-w-[32ch]">
              Zero-trust enterprise engineering, verified boundaries, and hardened operational controls by design.
            </p>
          </div>
        </div>
      </div>

      <!-- Action Panel & Founder Credit -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
        <a
          href={ownerUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-[#ff5722] text-[#0b0f12] font-semibold text-sm rounded transition-colors duration-150 hover:bg-[#ff7043] focus:outline-none focus:ring-2 focus:ring-[#ff5722] focus:ring-offset-2 focus:ring-offset-[#0b0f12] shadow-md shadow-black/40"
        >
          <span>Visit the founder (Viruchith)</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M17 7H7M17 7V17"></path>
          </svg>
        </a>

        <a
          href={`mailto:${contactEmail}`}
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 border border-[#1f2c37] bg-[#131a20] hover:bg-[#18222b] text-[#e2e8f0] text-sm font-medium rounded transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-[#ff5722] focus:ring-offset-2 focus:ring-offset-[#0b0f12] shadow-sm shadow-black/30"
        >
          <svg class="w-4 h-4 text-[#ff5722]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span>Contact Inquiries</span>
        </a>
      </div>

      <div class="text-xs text-[#8899a6] font-mono leading-relaxed max-w-[70ch]">
        Founded by <a href={ownerUrl} target="_blank" rel="noopener noreferrer" class="text-[#e2e8f0] underline decoration-[#ff5722] underline-offset-4 hover:text-[#ff5722] transition-colors font-medium">Viruchith</a>. Enterprise software engineering, high-availability architecture & resilient systems.
      </div>
    </main>

    <!-- Footer with Semantic Entity Linking & Verified Social Icons -->
    <footer class="mt-16 sm:mt-24 pt-6 border-t border-[#1f2c37] flex flex-col sm:flex-row items-center justify-between gap-6 text-xs font-mono text-[#8899a6]">
      <div class="flex items-center gap-2">
        <span>© {new Date().getFullYear()} Explodenot.</span>
        <span>Enterprise Software Development.</span>
      </div>

      <!-- Verified Social & Communication Links -->
      <div class="flex items-center gap-5">
        <a href={socialLinks.github} target="_blank" rel="noopener noreferrer" class="hover:text-[#ff5722] transition-colors focus:outline-none focus:underline" aria-label="Explodenot on GitHub">
          GitHub
        </a>
        <span class="text-[#1f2c37]" aria-hidden="true">•</span>
        <a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[#ff5722] transition-colors focus:outline-none focus:underline" aria-label="Explodenot on LinkedIn">
          LinkedIn
        </a>
        <span class="text-[#1f2c37]" aria-hidden="true">•</span>
        <a href={socialLinks.x} target="_blank" rel="noopener noreferrer" class="hover:text-[#ff5722] transition-colors focus:outline-none focus:underline" aria-label="Explodenot on X (Twitter)">
          X
        </a>
        <span class="text-[#1f2c37]" aria-hidden="true">•</span>
        <a href={`mailto:${contactEmail}`} class="hover:text-[#ff5722] transition-colors focus:outline-none focus:underline">
          {contactEmail}
        </a>
      </div>
    </footer>
  </div>
</Layout>
